backend/vendor
backend/node_modules
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
# Runtime install marker — must NOT be baked into images, or install.sh will
# skip migrations/seed on a fresh prod database (it is written per-environment
# after a successful install).
backend/storage/installed
backend/.env
backend/.env.example
backend/public/storage
# NOTE: compiled theme assets (public/themes/**/build) are intentionally NOT
# ignored — the prod image bakes them so bagisto_asset()/Vite can resolve the
# manifest. Without them every page calling bagisto_asset() aborts 404
# (Webkul\Theme\Theme::url). Run `make rebuild-assets` before building the
# prod image so these dirs are current.
frontend/node_modules
frontend/.next
**/.git
**/.DS_Store
