# Variables consumed by docker-compose.yml itself (ports, build args, and the
# MySQL container's own credentials). Keep DB_DATABASE/DB_USERNAME/DB_PASSWORD
# in sync with backend/.env — Laravel reads its copy from there, MySQL reads
# its copy from here.

COMPOSE_PROJECT_NAME=bagisto

UID=1000
GID=1000

NGINX_HTTP_PORT=8080
MYSQL_PORT=3307
REDIS_PORT=6380
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1025
ELASTICSEARCH_PORT=9200

DB_DATABASE=bagisto
DB_USERNAME=bagisto
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

QUEUE_WORKERS=2
